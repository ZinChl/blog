---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StarChart from '../components/StarChart.astro';
import { SITE } from '../site.config';
import { formatDate, isoDate, readingTime } from '../utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recent = posts.slice(0, SITE.homePostCount);
const [feature, ...rest] = recent;
const tagCount = new Set(posts.flatMap((post) => post.data.tags)).size;
const totalMinutes = posts.reduce((sum, post) => sum + readingTime(post.body ?? '').minutes, 0);

/** 列表里的编号：最新一篇编号最大 */
const noOf = (post: (typeof posts)[number]) =>
  String(posts.length - posts.findIndex((item) => item.id === post.id)).padStart(2, '0');

const marqueeItems = [
  SITE.titleEn,
  SITE.nameCn,
  'SIGNAL 001',
  'KNOWLEDGE · CURIOSITY · INFINITY',
  '在代码与群星之间',
  'UESTC · CHENGDU',
  `EST. ${SITE.since}`,
];
---

<BaseLayout>
  <Hero />

  <!-- 反色信号带 -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {
        [0, 1].map(() => (
          <div class="marquee__group">
            {marqueeItems.map((item) => (
              <span class="marquee__item">
                <span class="spark">✦</span>
                {item.includes('·') || item === SITE.titleEn ? <strong>{item}</strong> : item}
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- 01 / 最近写的东西：目录式索引 -->
  <section class="section" id="recent">
    <div class="wrap">
      <div class="section-head" data-reveal="fade">
        <div class="section-head__title">
          <span class="index-num" aria-hidden="true">01</span>
          <div>
            <p class="section-kicker">RECENT WRITING</p>
            <h2>最近写的<em>东西</em></h2>
          </div>
        </div>
        <div class="section-head__aside">
          <a class="link-underline" href="/blog/">全部文章 <span aria-hidden="true">→</span></a>
        </div>
      </div>

      {
        feature ? (
          <>
            <a class="entry entry--feature" href={`/blog/${feature.id}/`} data-reveal data-cursor="阅读">
              <span class="entry__no mono" aria-hidden="true">NO. {noOf(feature)}</span>
              <div class="entry__body">
                <p class="entry__meta mono">
                  <span class="entry__latest">LATEST</span>
                  <time datetime={isoDate(feature.data.pubDate)}>{formatDate(feature.data.pubDate)}</time>
                  <span aria-hidden="true">/</span>
                  <span>{readingTime(feature.body ?? '').minutes} MIN READ</span>
                </p>
                <h3 class="entry__title">{feature.data.title}</h3>
                <p class="entry__desc">{feature.data.description}</p>
                <span class="entry__read mono">
                  READ THE NOTE <span aria-hidden="true">↗</span>
                </span>
              </div>
              <div class="entry__figure" aria-hidden="true">
                <StarChart seed={feature.data.title} />
                <span class="entry__figure-label">FIG. 01 / SIGNAL</span>
              </div>
              <span class="entry__arrow" aria-hidden="true">↗</span>
            </a>

            {rest.length > 0 && (
              <ol class="entry-list">
                {rest.map((post, i) => (
                  <li>
                    <a
                      class="entry"
                      href={`/blog/${post.id}/`}
                      data-reveal
                      data-cursor="阅读"
                      style={`--reveal-delay:${Math.min(i * 0.06, 0.24)}s`}>
                      <span class="entry__no mono" aria-hidden="true">{noOf(post)}</span>
                      <time class="entry__date mono" datetime={isoDate(post.data.pubDate)}>
                        {formatDate(post.data.pubDate)}
                      </time>
                      <h3 class="entry__title">{post.data.title}</h3>
                      <span class="entry__tags mono" aria-hidden="true">
                        {post.data.tags.slice(0, 3).join(' / ')}
                      </span>
                      <span class="entry__arrow" aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </>
        ) : (
          <p class="empty">还没有文章。去 src/content/blog/ 里新建一个 .md 文件就能开始写了。</p>
        )
      }

      <div class="notes-more">
        <a class="btn btn--ghost" href="/blog/" data-magnetic>
          浏览全部档案
          <span class="btn-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 02 / 关于这间观测站：反色区 -->
  <section class="section" id="about">
    <div class="wrap">
      <div class="section-head" data-reveal="fade">
        <div class="section-head__title">
          <span class="index-num" aria-hidden="true">02</span>
          <div>
            <p class="section-kicker">ABOUT THE OBSERVATORY</p>
            <h2>关于这间<em>观测站</em></h2>
          </div>
        </div>
        <div class="section-head__aside">
          <a class="link-underline" href="/about/">完整关于页 <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="manifesto">
        <div data-reveal>
          <p class="manifesto__lead">
            一边写代码，一边<em>收集星光</em>。<br />
            这里是我的私人星图<span class="star-accent" aria-hidden="true">✦</span>
          </p>
          <div class="manifesto__body">
            <p>
              你好，我是 {SITE.author}，目前在 UESTC 读书。这个博客用来放技术笔记、学习记录，
              以及偶尔冒出来的想法 —— 写清楚，才算真的懂了。
            </p>
            <p>
              如果这些文字恰好对你有用，欢迎 <a href={SITE.social.find((s) => s.icon === 'email')?.href ?? '/about/'}>写信</a>
              给我，或者去 <a href={SITE.social.find((s) => s.icon === 'github')?.href ?? '#'} rel="noopener">GitHub</a> 看看我在折腾什么。
            </p>
          </div>
        </div>

        <div data-reveal style="--reveal-delay:.12s">
          <dl class="manifesto__log">
            <div class="log-row">
              <dt>STATUS</dt>
              <dd><span class="live-dot" aria-hidden="true"></span>在读 · 持续更新中</dd>
            </div>
            <div class="log-row">
              <dt>LOCATION</dt>
              <dd>{SITE.location} <span class="muted">· {SITE.coords}</span></dd>
            </div>
            <div class="log-row">
              <dt>STACK</dt>
              <dd>Astro · Azure SWA · Sveltia CMS</dd>
            </div>
            <div class="log-row">
              <dt>WRITING</dt>
              <dd>{SITE.since} — 至今 <span class="muted">· {posts.length} 篇</span></dd>
            </div>
            <div class="log-row">
              <dt>SIGNAL</dt>
              <dd><span class="clock" data-clock data-tz={SITE.timeZone}>--:--:--</span> <span class="muted">{SITE.clockLabel} · 北京时间</span></dd>
            </div>
          </dl>

          <div class="stats">
            <div class="stat">
              <span class="stat__value">{posts.length}<sup>篇</sup></span>
              <span class="stat__label">Notes</span>
            </div>
            <div class="stat">
              <span class="stat__value">{tagCount}<sup>个</sup></span>
              <span class="stat__label">Tags</span>
            </div>
            <div class="stat">
              <span class="stat__value">{totalMinutes}<sup>分</sup></span>
              <span class="stat__label">Reading</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 档案入口 -->
  <section class="home-cta">
    <div class="wrap">
      <a class="home-cta__link" href="/blog/" data-magnetic>
        <span class="home-cta__kicker mono">THE COMPLETE ARCHIVE — {posts.length} NOTES</span>
        <span class="home-cta__title">全部<em>文章</em><span class="home-cta__arrow" aria-hidden="true">↗</span></span>
        <span class="home-cta__meta mono">按时间排列 / RSS 订阅 / 慢慢翻</span>
      </a>
    </div>
  </section>
</BaseLayout>
