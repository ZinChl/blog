---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WallSky from '../components/WallSky.astro';
import { SITE } from '../site.config';

/**
 * 留言墙 —— 把散落在每篇文章下的留言按时间聚到一面墙上。
 * 留言是动态数据，这里只把「文章 id → 标题 / URL」的索引静态烘进页面，
 * 真正的留言在浏览器里通过 /api/comments?recent=1 拉取。
 */
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const articleIndex = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  url: `/blog/${post.id}/`,
}));

// 内嵌 JSON：转义 <，避免标题里的字符提前闭合 script
const articleJson = JSON.stringify(articleIndex).replace(/</g, '\\u003c');
---

<BaseLayout title="留言墙" description="散落在每篇文章里的留言，按时间收拢到这一面墙上。">
  <div class="wall" data-wall>
    <WallSky />

    <!-- 题头 -->
    <header class="wall-hero">
      <div class="wall-hero__glow" aria-hidden="true"></div>
      <div class="wall-hero__grid" aria-hidden="true"></div>
      <div class="wall-hero__constellation" data-constellation aria-hidden="true">
        <canvas></canvas>
        <span class="wall-hero__constellation-hint mono">SIGNAL CONSTELLATION · 点星定位</span>
        <div class="wall-constellation-tip" data-constellation-tip></div>
      </div>

      <div class="wrap wall-hero__inner">
        <div class="wall-hero__top" data-reveal="fade">
          <p class="eyebrow">TRANSMISSIONS / 留言墙</p>
          <p class="wall-hero__vol mono">
            VOL. I <span aria-hidden="true">·</span> {SITE.locationEn}
            <span aria-hidden="true">·</span> {SITE.clockLabel}
          </p>
        </div>

        <h1 class="wall-hero__title" data-reveal>
          留言<em>墙</em>
          <span class="wall-hero__latin" aria-hidden="true">The Signal Wall</span>
        </h1>

        <div class="wall-hero__bottom">
          <p class="wall-hero__intro" data-reveal style="--reveal-delay:.08s">
            散落在每篇文章里的留言，按时间收拢到这一面墙上。点开任意一张卡片，
            回到它落下的那篇文章，也回到那条留言旁边。
          </p>

          <dl class="wall-hero__stats" data-reveal style="--reveal-delay:.16s">
            <div class="wall-stat">
              <dt>SIGNALS</dt>
              <dd><span data-wall-total>—</span><span>条</span></dd>
            </div>
            <div class="wall-stat">
              <dt>SOURCES</dt>
              <dd><span data-wall-sources>—</span><span>篇</span></dd>
            </div>
            <div class="wall-stat">
              <dt>LATEST</dt>
              <dd class="wall-stat--date" data-wall-latest>—</dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <!-- 墙 -->
    <div class="wrap wall-body">
      <div class="wall-bar" data-reveal="fade">
        <p class="wall-bar__status mono" data-wall-status aria-live="polite">正在接收信号…</p>
        <button class="wall-refresh" type="button" data-wall-refresh>
          刷新 <span aria-hidden="true">↻</span>
        </button>
      </div>

      <noscript>
        <p class="wall-noscript">
          留言墙需要 JavaScript 才能读取留言数据。开启后刷新即可，或者直接去
          <a class="link-underline" href="/blog/">文章页的留言区</a>。
        </p>
      </noscript>

      <h2 class="sr-only" id="wall-list-title">最近留言</h2>
      <div class="wall-grid is-loading" data-wall-grid aria-labelledby="wall-list-title"></div>

      <p class="wall-note mono" data-wall-note hidden></p>

      <div class="wall-empty" data-wall-empty hidden>
        <span class="wall-empty__mark" aria-hidden="true">✦</span>
        <p>还没有收到任何信号。</p>
        <a class="link-underline" href="/blog/">去文章里留下第一条 <span aria-hidden="true">→</span></a>
      </div>

      <div class="wall-error" data-wall-error hidden>
        <p class="wall-error__text">信号暂时没有接通。</p>
        <button class="btn btn--ghost" type="button" data-wall-retry>
          重试 <span aria-hidden="true">↻</span>
        </button>
      </div>

      <footer class="wall-foot" data-reveal="fade">
        <p class="wall-foot__line">
          每一条留言都来自某篇文章的留言区，按时间倒序排列。
          <span aria-hidden="true">·</span>
          点卡片回到原文。
        </p>
        <a class="btn" href="/blog/">去看文章 <span class="btn-arrow" aria-hidden="true">↗</span></a>
      </footer>
    </div>
  </div>

  <script type="application/json" id="wall-articles" is:inline set:html={articleJson}></script>

  <script>
    interface WallArticle {
      id: string;
      title: string;
      url: string;
    }

    interface WallComment {
      id: string;
      slug: string;
      name: string;
      body: string;
      createdAt: string;
    }

    interface RecentPayload {
      count?: number;
      total?: number;
      comments?: WallComment[];
      error?: string;
    }

    const wall = document.querySelector<HTMLElement>('[data-wall]');

    if (wall) {
      const API = '/api/comments?recent=1&limit=100';

      const grid = wall.querySelector<HTMLElement>('[data-wall-grid]');
      const statusEl = wall.querySelector<HTMLElement>('[data-wall-status]');
      const totalEl = wall.querySelector<HTMLElement>('[data-wall-total]');
      const sourcesEl = wall.querySelector<HTMLElement>('[data-wall-sources]');
      const latestEl = wall.querySelector<HTMLElement>('[data-wall-latest]');
      const noteEl = wall.querySelector<HTMLElement>('[data-wall-note]');
      const emptyEl = wall.querySelector<HTMLElement>('[data-wall-empty]');
      const errorEl = wall.querySelector<HTMLElement>('[data-wall-error]');
      const retryBtn = wall.querySelector<HTMLButtonElement>('[data-wall-retry]');
      const refreshBtn = wall.querySelector<HTMLButtonElement>('[data-wall-refresh]');

      let articles: WallArticle[] = [];
      try {
        articles = JSON.parse(document.getElementById('wall-articles')?.textContent || '[]');
      } catch {
        articles = [];
      }
      const articleById = new Map(articles.map((article) => [article.id, article]));

      const pad = (n: number) => String(n).padStart(2, '0');
      const fullTime = (iso: string) => {
        const d = new Date(iso);
        if (Number.isNaN(d.getTime())) return '';
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
      };
      const shortTime = (iso: string) => {
        const d = new Date(iso);
        if (Number.isNaN(d.getTime())) return '';
        return `${pad(d.getMonth() + 1)}.${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
      };

      function setHidden(el: HTMLElement | null, hidden: boolean) {
        if (el) el.hidden = hidden;
      }

      function setStatus(text: string) {
        if (statusEl) statusEl.textContent = text;
      }

      /* ---------- 题头星图：把最近留言画成一张可点击的星座 ---------- */
      interface ConstellationHandle {
        setComments: (list: WallComment[]) => void;
        setCardHover: (id: string | null) => void;
      }

      const constellationRoot = wall.querySelector<HTMLElement>('[data-constellation]');
      let constellation: ConstellationHandle | null = null;

      function createConstellation(root: HTMLElement): ConstellationHandle | null {
        const canvas = root.querySelector<HTMLCanvasElement>('canvas');
        const tip = root.querySelector<HTMLElement>('[data-constellation-tip]');
        const ctx = canvas?.getContext('2d');
        if (!canvas || !ctx) return null;

        interface Star {
          comment: WallComment;
          angle: number;
          rad: number;
          size: number;
          gold: boolean;
          phase: number;
        }

        const reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

        let comments: WallComment[] = [];
        let stars: Star[] = [];
        let w = 0;
        let h = 0;
        let dpr = 1;
        let localHover: string | null = null;
        let cardHover: string | null = null;
        let running = false;
        let raf = 0;
        let lastFrame = 0;
        let time = 0;
        let pointerInside = false;
        const pointer = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5 };

        const hash01 = (input: string) => {
          let hsh = 2166136261;
          for (let i = 0; i < input.length; i += 1) {
            hsh ^= input.charCodeAt(i);
            hsh = Math.imul(hsh, 16777619);
          }
          return ((hsh >>> 0) % 10000) / 10000;
        };

        const activeId = () => localHover || cardHover;

        const starPoint = (star: Star) => {
          const radius = Math.min(w, h) * 0.44;
          const ox = (pointer.x - 0.5) * 10;
          const oy = (pointer.y - 0.5) * 8;
          return {
            x: w / 2 + ox + Math.cos(star.angle) * star.rad * radius,
            y: h / 2 + oy + Math.sin(star.angle) * star.rad * radius,
          };
        };

        function setActiveCard(id: string | null) {
          if (!grid) return;
          grid.querySelectorAll<HTMLElement>('.wall-card.is-linked').forEach((el) => {
            el.classList.remove('is-linked');
          });
          if (!id) return;
          grid
            .querySelector<HTMLElement>(`.wall-card[data-comment-id="${id}"]`)
            ?.classList.add('is-linked');
        }

        function showTip(star: Star | null) {
          if (!tip) return;
          if (!star) {
            tip.classList.remove('is-visible');
            return;
          }
          const point = starPoint(star);
          const body = star.comment.body.replace(/\s+/g, ' ');
          const excerpt = body.length > 30 ? `${body.slice(0, 30)}…` : body;
          tip.textContent = `${star.comment.name || '匿名'} · ${shortTime(star.comment.createdAt)} — ${excerpt}`;

          // 靠上的星把说明放到下方，避免压住 VOL. 行；左右再收进画布内
          const below = point.y < h * 0.3;
          tip.classList.toggle('is-below', below);
          tip.classList.add('is-visible');
          const tipWidth = Math.max(120, Math.min(240, tip.offsetWidth || 170));
          const left = Math.min(Math.max(point.x, tipWidth / 2 + 6), Math.max(6, w - tipWidth / 2 - 6));
          tip.style.left = `${left}px`;
          tip.style.top = `${point.y}px`;
        }

        function layout() {
          const count = comments.length;
          stars = comments.map((comment, index) => {
            const a = hash01(`${comment.id}:a`);
            const b = hash01(`${comment.id}:b`);
            const angle = index * 0.86 + 0.7 + (a - 0.5) * 0.16;
            const rad =
              0.2 +
              0.66 * Math.pow((index + 1) / Math.max(1, count), 0.8) +
              (b - 0.5) * 0.05;
            return {
              comment,
              angle,
              rad,
              size: 1.6 + (1 - index / Math.max(1, count)) * 1.5,
              gold: a > 0.86,
              phase: b * Math.PI * 2,
            };
          });
        }

        function resize() {
          const rect = root.getBoundingClientRect();
          if (rect.width < 10 || rect.height < 10) return;
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          w = rect.width;
          h = rect.height;
          canvas.width = Math.round(w * dpr);
          canvas.height = Math.round(h * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        function draw(animate: boolean) {
          if (!w || !h) return;
          ctx.clearRect(0, 0, w, h);

          const cx = w / 2 + (pointer.x - 0.5) * 10;
          const cy = h / 2 + (pointer.y - 0.5) * 8;
          const radius = Math.min(w, h) * 0.44;

          ctx.save();
          ctx.translate(cx, cy);
          ctx.lineWidth = 0.7;

          ctx.strokeStyle = 'rgba(242, 242, 239, 0.16)';
          ctx.beginPath();
          ctx.arc(0, 0, radius * 0.98, 0, Math.PI * 2);
          ctx.stroke();

          ctx.strokeStyle = 'rgba(159, 230, 255, 0.22)';
          ctx.setLineDash([2, 7]);
          ctx.lineDashOffset = animate ? -time * 13 : 0;
          ctx.beginPath();
          ctx.arc(0, 0, radius * 0.74, 0, Math.PI * 2);
          ctx.stroke();
          ctx.setLineDash([]);

          ctx.strokeStyle = 'rgba(242, 242, 239, 0.09)';
          ctx.beginPath();
          ctx.arc(0, 0, radius * 0.46, 0, Math.PI * 2);
          ctx.stroke();

          ctx.strokeStyle = 'rgba(242, 242, 239, 0.08)';
          ctx.beginPath();
          ctx.moveTo(-radius * 1.04, 0);
          ctx.lineTo(radius * 1.04, 0);
          ctx.moveTo(0, -radius * 1.04);
          ctx.lineTo(0, radius * 1.04);
          ctx.stroke();

          for (let i = 0; i < 12; i += 1) {
            const angle = (i / 12) * Math.PI * 2;
            const inner = i % 3 === 0 ? radius * 0.94 : radius * 0.965;
            ctx.beginPath();
            ctx.moveTo(Math.cos(angle) * inner, Math.sin(angle) * inner);
            ctx.lineTo(Math.cos(angle) * radius * 1.02, Math.sin(angle) * radius * 1.02);
            ctx.stroke();
          }
          ctx.restore();

          // 星图中心的小黑洞：一个黑色剪影 + 一圈冷光，和首页那颗大黑洞呼应
          const coreRadius = Math.max(7, radius * 0.06);
          const coreGlow = ctx.createRadialGradient(cx, cy, coreRadius * 0.6, cx, cy, coreRadius * 3.4);
          coreGlow.addColorStop(0, 'rgba(159, 230, 255, 0.16)');
          coreGlow.addColorStop(1, 'rgba(159, 230, 255, 0)');
          ctx.fillStyle = coreGlow;
          ctx.beginPath();
          ctx.arc(cx, cy, coreRadius * 3.4, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = '#000000';
          ctx.beginPath();
          ctx.arc(cx, cy, coreRadius, 0, Math.PI * 2);
          ctx.fill();

          ctx.strokeStyle = 'rgba(214, 247, 255, 0.5)';
          ctx.lineWidth = 0.8;
          ctx.beginPath();
          ctx.arc(cx, cy, coreRadius + 2.4, 0, Math.PI * 2);
          ctx.stroke();

          if (stars.length === 0) return;

          const points = stars.map(starPoint);

          ctx.beginPath();
          points.forEach((point, index) => {
            if (index === 0) ctx.moveTo(point.x, point.y);
            else ctx.lineTo(point.x, point.y);
          });
          ctx.strokeStyle = 'rgba(159, 230, 255, 0.13)';
          ctx.lineWidth = 0.7;
          ctx.stroke();

          // 沿着星座路径往前跑的信号点
          if (animate && stars.length > 1) {
            const span = stars.length - 1;
            const progress = ((time * 0.055) % 1) * span;
            const index = Math.floor(progress);
            const frac = progress - index;
            const a = points[index];
            const b = points[Math.min(index + 1, points.length - 1)];
            const x = a.x + (b.x - a.x) * frac;
            const y = a.y + (b.y - a.y) * frac;

            const glow = ctx.createRadialGradient(x, y, 0, x, y, 10);
            glow.addColorStop(0, 'rgba(214, 247, 255, 0.85)');
            glow.addColorStop(1, 'rgba(159, 230, 255, 0)');
            ctx.fillStyle = glow;
            ctx.beginPath();
            ctx.arc(x, y, 10, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = 'rgba(214, 247, 255, 0.95)';
            ctx.beginPath();
            ctx.arc(x, y, 1.5, 0, Math.PI * 2);
            ctx.fill();
          }

          const active = activeId();
          stars.forEach((star, index) => {
            const point = points[index];
            const isActive = star.comment.id === active;
            const twinkle = animate ? 0.75 + 0.25 * Math.sin(time * 1.8 + star.phase) : 0.9;
            const r = star.size * (isActive ? 1.7 : 1) * twinkle;

            const haloRadius = r * (isActive ? 7 : 4.5);
            const halo = ctx.createRadialGradient(point.x, point.y, 0, point.x, point.y, haloRadius);
            halo.addColorStop(
              0,
              star.gold ? 'rgba(230, 180, 95, 0.30)' : 'rgba(159, 230, 255, 0.26)',
            );
            halo.addColorStop(1, star.gold ? 'rgba(230, 180, 95, 0)' : 'rgba(159, 230, 255, 0)');
            ctx.fillStyle = halo;
            ctx.beginPath();
            ctx.arc(point.x, point.y, haloRadius, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = isActive
              ? '#d6f7ff'
              : star.gold
                ? '#e6b45f'
                : 'rgba(242, 242, 239, 0.92)';
            ctx.beginPath();
            ctx.arc(point.x, point.y, r, 0, Math.PI * 2);
            ctx.fill();

            if (isActive) {
              ctx.strokeStyle = 'rgba(159, 230, 255, 0.75)';
              ctx.lineWidth = 0.9;
              ctx.setLineDash([3, 4]);
              ctx.lineDashOffset = animate ? -time * 20 : 0;
              ctx.beginPath();
              ctx.arc(point.x, point.y, r + 6, 0, Math.PI * 2);
              ctx.stroke();
              ctx.setLineDash([]);
            }
          });
        }

        function hitTest(clientX: number, clientY: number): Star | null {
          if (!stars.length) return null;
          const rect = canvas.getBoundingClientRect();
          const x = clientX - rect.left;
          const y = clientY - rect.top;
          let best: Star | null = null;
          let bestDistance = 20;
          for (const star of stars) {
            const point = starPoint(star);
            const distance = Math.hypot(point.x - x, point.y - y);
            if (distance < bestDistance) {
              best = star;
              bestDistance = distance;
            }
          }
          return best;
        }

        function setHover(star: Star | null) {
          const id = star?.comment.id ?? null;
          if (id === localHover) return;
          localHover = id;
          showTip(star);
          setActiveCard(id);
          if (!running) draw(false);
        }

        function frame(now: number) {
          raf = 0;
          if (!running) return;
          const delta = Math.min(0.05, Math.max(0, (now - (lastFrame || now)) / 1000));
          lastFrame = now;
          time += delta;
          pointer.x += (pointer.tx - pointer.x) * 0.06;
          pointer.y += (pointer.ty - pointer.y) * 0.06;
          draw(true);
          raf = requestAnimationFrame(frame);
        }

        function start() {
          if (running || reduceQuery.matches) return;
          running = true;
          lastFrame = 0;
          if (!raf) raf = requestAnimationFrame(frame);
        }

        function stop() {
          running = false;
          if (raf) cancelAnimationFrame(raf);
          raf = 0;
        }

        canvas.addEventListener('pointermove', (event) => {
          const rect = canvas.getBoundingClientRect();
          pointer.tx = (event.clientX - rect.left) / Math.max(1, rect.width);
          pointer.ty = (event.clientY - rect.top) / Math.max(1, rect.height);
          pointerInside = true;
          setHover(hitTest(event.clientX, event.clientY));
          if (!running && !reduceQuery.matches) start();
        });

        canvas.addEventListener('pointerleave', () => {
          pointerInside = false;
          setHover(null);
        });

        canvas.addEventListener('click', (event) => {
          const star = hitTest(event.clientX, event.clientY);
          if (!star) return;
          const card = grid?.querySelector<HTMLElement>(
            `.wall-card[data-comment-id="${star.comment.id}"]`,
          );
          if (!card) return;

          const lenis = (window as Window & {
            lenis?: { scrollTo: (target: Element, options?: { offset?: number }) => void };
          }).lenis;
          if (lenis) lenis.scrollTo(card, { offset: -120 });
          else card.scrollIntoView({ behavior: 'smooth', block: 'start' });

          card.classList.remove('is-pulsed');
          void card.offsetWidth;
          card.classList.add('is-pulsed');
          window.setTimeout(() => card.classList.remove('is-pulsed'), 1800);
        });

        const ro = 'ResizeObserver' in window ? new ResizeObserver(() => {
          resize();
          if (!running) draw(false);
        }) : null;
        ro?.observe(root);

        const io = 'IntersectionObserver' in window
          ? new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting && !reduceQuery.matches) start();
                  else {
                    stop();
                    draw(false);
                  }
                }
              },
              { threshold: 0.05 },
            )
          : null;
        io?.observe(root);

        const themeObserver = new MutationObserver(() => {
          resize();
          if (!running) draw(false);
        });
        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });

        resize();
        layout();
        draw(false);
        root.classList.add('is-live');

        return {
          setComments(list: WallComment[]) {
            comments = list;
            layout();
            resize();
            draw(false);
          },
          setCardHover(id: string | null) {
            cardHover = id;
            if (!running) draw(false);
          },
        };
      }

      if (constellationRoot) constellation = createConstellation(constellationRoot);

      function buildCard(comment: WallComment, index: number, total: number): HTMLAnchorElement | null {
        const article = articleById.get(comment.slug);
        if (!article) return null;

        const link = document.createElement('a');
        link.className = 'wall-card';
        link.href = `${article.url}#comment-${encodeURIComponent(comment.id)}`;
        link.dataset.commentId = comment.id;
        link.style.setProperty('--i', String(Math.min(index, 12)));

        link.addEventListener('mouseenter', () => constellation?.setCardHover(comment.id));
        link.addEventListener('mouseleave', () => constellation?.setCardHover(null));

        const no = document.createElement('span');
        no.className = 'wall-card__no mono';
        no.setAttribute('aria-hidden', 'true');
        no.textContent = `Nº ${String(total - index).padStart(3, '0')}`;

        const head = document.createElement('div');
        head.className = 'wall-card__head';

        const name = document.createElement('span');
        name.className = 'wall-card__name';
        name.textContent = comment.name || '匿名';

        const time = document.createElement('time');
        time.className = 'wall-card__time mono';
        time.dateTime = comment.createdAt;
        time.title = fullTime(comment.createdAt);
        time.textContent = shortTime(comment.createdAt);

        head.append(name, time);

        const body = document.createElement('p');
        body.className = 'wall-card__body';
        body.textContent = comment.body;

        const foot = document.createElement('div');
        foot.className = 'wall-card__foot';

        const source = document.createElement('span');
        source.className = 'wall-card__src';
        source.textContent = `《${article.title}》`;

        const arrow = document.createElement('span');
        arrow.className = 'wall-card__arrow';
        arrow.setAttribute('aria-hidden', 'true');
        arrow.textContent = '↗';

        foot.append(source, arrow);
        link.append(no, head, body, foot);

        return link;
      }

      function paintStats(comments: WallComment[]) {
        const sources = new Set(comments.map((comment) => comment.slug));
        const latest = comments.reduce((acc, comment) => {
          return comment.createdAt > acc ? comment.createdAt : acc;
        }, '');

        if (totalEl) totalEl.textContent = String(comments.length);
        if (sourcesEl) sourcesEl.textContent = String(sources.size);
        if (latestEl) latestEl.textContent = latest ? shortTime(latest) : '—';
      }

      function render(comments: WallComment[], total: number) {
        if (!grid) return;
        grid.classList.remove('is-loading');
        grid.replaceChildren();
        paintStats(comments);

        setHidden(emptyEl, comments.length > 0);
        setHidden(noteEl, true);

        if (comments.length === 0) {
          constellation?.setComments([]);
          setStatus('还没有信号');
          return;
        }

        const cards: HTMLAnchorElement[] = [];
        comments.forEach((comment, index) => {
          const card = buildCard(comment, index, comments.length);
          if (card) cards.push(card);
        });

        if (cards.length === 0) {
          setStatus('还没有信号');
          setHidden(emptyEl, false);
          return;
        }

        grid.append(...cards);
        constellation?.setComments(comments);
        setStatus(`已接收 ${cards.length} 条信号 · 按时间倒序`);

        if (total > comments.length && noteEl) {
          noteEl.textContent = `展示最近 ${comments.length} 条 · 共 ${total} 条`;
          setHidden(noteEl, false);
        }
      }

      async function load() {
        setHidden(errorEl, true);
        setHidden(emptyEl, true);
        setStatus('正在接收信号…');
        if (refreshBtn) refreshBtn.disabled = true;

        try {
          const res = await fetch(API, { headers: { Accept: 'application/json' } });
          const data = (await res.json().catch(() => ({}))) as RecentPayload;
          if (!res.ok) throw new Error(data.error || '加载失败');

          const comments = (data.comments || [])
            .filter((comment) => articleById.has(comment.slug))
            .sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt)));

          render(comments, data.total ?? comments.length);
        } catch (err) {
          if (grid) grid.classList.remove('is-loading');
          constellation?.setComments([]);
          setStatus('信号接收失败');
          setHidden(errorEl, false);
          if (errorEl) {
            const text = errorEl.querySelector<HTMLElement>('.wall-error__text');
            if (text) {
              const message = err instanceof Error ? err.message : String(err);
              text.textContent = `信号暂时没有接通（${message}）。`;
            }
          }
        } finally {
          if (refreshBtn) refreshBtn.disabled = false;
        }
      }

      retryBtn?.addEventListener('click', () => void load());
      refreshBtn?.addEventListener('click', () => void load());

      void load();
    }
  </script>
</BaseLayout>
