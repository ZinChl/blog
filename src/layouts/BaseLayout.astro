---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Cursor from '../components/Cursor.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** 文章页面传入发布日期等额外 meta */
  type?: 'website' | 'article';
}

const { title, description = SITE.description, type = 'website' } = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const pageType = isHome
  ? 'home'
  : pathname.startsWith('/blog/')
    ? 'article-or-list'
    : pathname.replace(/^\/|\/$/g, '') || 'home';

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.nameCn}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const github = SITE.social.find((s) => s.icon === 'github');
const socialIcon = (icon: string) =>
  icon === 'github' ? 'github' : icon === 'email' ? 'email' : icon === 'rss' ? 'rss' : 'link';
---

<!doctype html>
<html lang={SITE.lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#070a14" id="theme-color-meta" />

    <link
      rel="preload"
      href="/fonts/cormorant-garamond-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-latin-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site ?? Astro.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.jpg', Astro.site ?? Astro.url).href} />

    <script is:inline>
      // 在渲染前定好主题，避免白屏闪烁。默认深空主题，用户手动切换后记住选择。
      (() => {
        try {
          // ?theme=light / ?theme=dark 便于预览与分享特定配色
          const param = new URLSearchParams(location.search).get('theme');
          const saved = localStorage.getItem('theme');
          const dark = param === 'light' ? false : param === 'dark' ? true : saved ? saved === 'dark' : true;
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
          const meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', dark ? '#070a14' : '#ede8dd');
        } catch (_) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>

  <body data-page={pageType}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div id="top"></div>

    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>

    <header class="site-header" data-site-header>
      <div class="header-inner">
        <a class="brand" href="/">
          <svg class="brand-sigil" viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false">
            <circle cx="20" cy="20" r="15.5" stroke="currentColor" stroke-opacity=".4" stroke-width="1"></circle>
            <circle
              cx="20"
              cy="20"
              r="10.8"
              stroke="currentColor"
              stroke-opacity=".22"
              stroke-width=".8"
              stroke-dasharray="1.5 3.2"></circle>
            <path
              d="M20 7.4 21.75 18.25 32.6 20l-10.85 1.75L20 32.6l-1.75-10.85L7.4 20l10.85-1.75L20 7.4Z"
              fill="currentColor"></path>
            <circle cx="20" cy="20" r="2.1" fill="currentColor" fill-opacity=".85"></circle>
            <path
              d="M20 2.6v3.2M20 34.2v3.2M2.6 20h3.2M34.2 20h3.2"
              stroke="currentColor"
              stroke-width=".9"
              stroke-linecap="round"
              stroke-opacity=".45"></path>
          </svg>
          <span class="brand-name">
            <strong>{SITE.title}</strong>
            <small>{SITE.titleEn}</small>
          </span>
          <span class="sr-only">{SITE.nameCn}，返回首页</span>
        </a>

        <nav class="site-nav" aria-label="主导航">
          {
            SITE.nav.map((item) => {
              const current =
                item.href === '/' ? pathname === '/' : pathname.startsWith(item.href);
              return (
                <a class="site-nav__link" href={item.href} aria-current={current ? 'page' : undefined}>
                  {item.label}
                </a>
              );
            })
          }
        </nav>

        <div class="header-actions">
          {
            github && (
              <a
                class="icon-btn icon-btn--github"
                href={github.href}
                target="_blank"
                rel="me noopener"
                aria-label="GitHub">
                <Icon name="github" size={17} />
              </a>
            )
          }
          <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="切换深浅色主题" title="切换深浅色主题">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
          <button
            class="menu-toggle"
            type="button"
            data-menu-toggle
            aria-label="打开导航菜单"
            aria-expanded="false"
            aria-controls="mobile-menu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <nav class="mobile-menu" id="mobile-menu" aria-label="移动端导航" inert>
      <nav>
        {SITE.nav.map((item, i) => (
          <a href={item.href}>
            <small>{String(i + 1).padStart(2, '0')}</small>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="mobile-menu__meta">
        <span>{SITE.location}</span>
        <span>{SITE.coords}</span>
      </div>
    </nav>

    <main id="main" class:list={{ page: true, 'page--home': isHome }}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div class="footer-brand">
            <a class="footer-wordmark" href="/" aria-label="21nc 星海档案，返回首页">{SITE.title}</a>
            <p>{SITE.footerLine}</p>
            <p class="footer-latin">{SITE.footerLatin}</p>
          </div>

          <div class="footer-col">
            <h3>Navigate</h3>
            <ul>
              {SITE.nav.map((item) => (
                <li><a href={item.href}>{item.label}<Icon name="arrow-up-right" size={11} /></a></li>
              ))}
              <li><a href="/rss.xml">RSS<Icon name="rss" size={11} /></a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3>Elsewhere</h3>
            <ul>
              {SITE.social.map((item) => (
                <li>
                  <a href={item.href} rel="me noopener" target={item.href.startsWith('http') ? '_blank' : undefined}>
                    {item.label}
                    <Icon name={socialIcon(item.icon)} size={11} />
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="footer-col">
            <h3>Observatory</h3>
            <p class="footer-note">
              {SITE.location}<br />
              {SITE.coords}<br />
              <span class="clock" data-clock data-tz={SITE.timeZone}>--:--:--</span>
              <span> {SITE.clockLabel}</span><br />
              本站由 Astro 生成 · Azure 托管
            </p>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} {SITE.copyrightName} · ALL RIGHTS RESERVED</span>
          <div class="footer-meta">
            <span>EST. {SITE.since}</span>
            <span class="dot"></span>
            <span>VOL. I — A PERSONAL ATLAS</span>
            <span class="dot"></span>
            <span>DEEP FIELD — NASA/STScI</span>
            <span class="dot"></span>
            <a href="#top">回到顶部 ↑</a>
          </div>
        </div>
      </div>
    </footer>

    <button class="to-top" type="button" data-to-top aria-label="回到顶部">
      <Icon name="arrow-up" size={16} />
    </button>

    <Cursor />

    <script>
      // 主题切换 + 移动菜单 + 回到顶部（基础交互；动效系统见 src/scripts/motion.ts）
      const root = document.documentElement;

      const setTheme = (theme: 'dark' | 'light') => {
        root.classList.add('theme-transition');
        root.dataset.theme = theme;
        try {
          localStorage.setItem('theme', theme);
        } catch (_) {}
        const meta = document.getElementById('theme-color-meta');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#070a14' : '#ede8dd');
        window.setTimeout(() => root.classList.remove('theme-transition'), 500);
      };

      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      // 移动端菜单
      const menu = document.getElementById('mobile-menu');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const setMenu = (open: boolean) => {
        document.body.classList.toggle('menu-open', open);
        menuToggle?.setAttribute('aria-expanded', String(open));
        menuToggle?.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
        if (menu) menu.toggleAttribute('inert', !open);
      };
      menuToggle?.addEventListener('click', () => setMenu(!document.body.classList.contains('menu-open')));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.body.classList.contains('menu-open')) setMenu(false);
      });
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

      // 回到顶部
      const toTop = document.querySelector<HTMLButtonElement>('[data-to-top]');
      const lenis = () => (window as unknown as { lenis?: { scrollTo: (t: number) => void } }).lenis;
      toTop?.addEventListener('click', () => {
        if (lenis()) lenis()!.scrollTo(0);
        else window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      const onScroll = () => {
        const y = window.scrollY;
        document.querySelector('[data-site-header]')?.classList.toggle('is-scrolled', y > 24);
        toTop?.classList.toggle('is-visible', y > window.innerHeight * 0.8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>

    {/* 动效系统：滚动显现 / Lenis / 光标 / 星野画布由 motion.ts 与对应组件提供 */}
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
