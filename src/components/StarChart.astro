---
/**
 * 星图缩略 —— 用文章标题当种子，生成一张确定性的小星座图。
 * 同一篇文章每次构建出来的星图都一样，但每篇都不一样。
 */
interface Props {
  seed: string;
  class?: string;
}

const { seed, class: className } = Astro.props;

function hashString(str: string): number {
  let h = 2166136261 >>> 0;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function mulberry32(a: number) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(hashString(seed));

const stars = Array.from({ length: 30 }, () => {
  const r = rand();
  return {
    x: +(16 + rand() * 288).toFixed(1),
    y: +(14 + rand() * 172).toFixed(1),
    r: +(r < 0.12 ? 1.7 : r < 0.42 ? 1 : 0.6).toFixed(2),
    o: +(0.3 + rand() * 0.65).toFixed(2),
  };
});

// 把最亮的几颗连成星座线
const bright = [...stars].sort((a, b) => b.r - a.r).slice(0, 7).sort((a, b) => a.x - b.x);
const lines = bright.slice(1).map((s, i) => ({ a: bright[i], b: s }));

const planet = {
  x: +(60 + rand() * 200).toFixed(1),
  y: +(46 + rand() * 108).toFixed(1),
  r: +(2.6 + rand() * 1.8).toFixed(2),
};

const ra = `${String(Math.floor(rand() * 24)).padStart(2, '0')}H ${String(Math.floor(rand() * 60)).padStart(2, '0')}M`;
const dec = `${rand() > 0.5 ? '+' : '−'}${String(Math.floor(rand() * 60)).padStart(2, '0')}°`;
---

<svg
  class:list={['starchart', className]}
  viewBox="0 0 320 200"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false">
  <defs>
    <radialGradient id={`sc-glow-${hashString(seed)}`} cx="0" cy="0" r="1" gradientTransform={`translate(${planet.x} ${planet.y}) rotate(90) scale(32)`} gradientUnits="userSpaceOnUse">
      <stop stop-color="#b4abf0" stop-opacity=".5"></stop>
      <stop offset="1" stop-color="#b4abf0" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <!-- 淡淡的经纬网格 -->
  <g stroke="currentColor" stroke-opacity=".08" stroke-width=".5">
    <path d="M0 50h320M0 100h320M0 150h320"></path>
    <path d="M80 0v200M160 0v200M240 0v200"></path>
  </g>

  <circle cx={planet.x} cy={planet.y} r="32" fill={`url(#sc-glow-${hashString(seed)})`}></circle>
  <circle class="sc-ring" cx={planet.x} cy={planet.y} r={planet.r + 4.5} transform={`rotate(-24 ${planet.x} ${planet.y})`}></circle>
  <circle class="sc-planet" cx={planet.x} cy={planet.y} r={planet.r}></circle>

  <g class="sc-line">
    {lines.map((l) => (
      <line x1={l.a.x} y1={l.a.y} x2={l.b.x} y2={l.b.y}></line>
    ))}
  </g>

  <g>
    {stars.map((s) => (
      <circle class="sc-star" cx={s.x} cy={s.y} r={s.r} fill-opacity={s.o}></circle>
    ))}
  </g>

  <g class="sc-label">
    <text x="16" y="192">{ra} / {dec}</text>
    <text x="304" y="192" text-anchor="end">21NC · FIELD CHART</text>
  </g>
</svg>
