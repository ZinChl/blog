---
/**
 * 留言区 —— Azure Functions API 的展示层。
 * 视觉已重做（样式在 styles/pages.css 的 comments 段落），但 data-* 钩子与
 * 请求逻辑保持不变：POST /api/comments、GET ?slug=、DELETE ?slug=&id=，
 * 蜜罐字段 website + elapsed 反机器人时长判断都照旧。
 */
interface Props {
  /** 文章 id，作为留言的分区键 */
  slug: string;
}

const { slug } = Astro.props;
---

<section class="comments" id="comments" data-comments data-slug={slug}>
  <header class="comments__head">
    <div class="comments__titles">
      <p class="comments__eyebrow eyebrow eyebrow--plain">TRANSMISSIONS</p>
      <h2 class="comments__title">留言<span class="comments-count" data-count></span></h2>
    </div>
    <div class="comments__aside">
      <p class="comments__hint">留下一条信号，等它穿过星海。</p>
      <a class="comments__wall-link mono" href="/wall/">全部留言 <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <div class="comments__list" data-list>
    <p class="comments-status" data-status aria-live="polite">正在加载留言…</p>
  </div>

  <form class="comment-form" data-form>
    <div class="comment-field">
      <label for={`c-name-${slug}`}>
        昵称<span class="comment-hint">可留空，默认显示「匿名」</span>
      </label>
      <input
        id={`c-name-${slug}`}
        name="name"
        type="text"
        maxlength="40"
        autocomplete="nickname"
        placeholder="匿名"
      />
    </div>

    <div class="comment-field">
      <label for={`c-body-${slug}`}>内容</label>
      <textarea
        id={`c-body-${slug}`}
        name="body"
        rows="4"
        maxlength="2000"
        required
        placeholder="说点什么…"></textarea>
    </div>

    <!-- 蜜罐：对人隐藏，机器人会填 —— 填了就拒 -->
    <div class="comment-honeypot">
      <label for={`c-web-${slug}`}>Website</label>
      <input
        id={`c-web-${slug}`}
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="comment-actions">
      <button type="submit" class="comment-submit" data-submit>
        发表留言
        <span class="comment-submit__arrow" aria-hidden="true">↗</span>
      </button>
      <p class="comment-form-status" data-form-status role="status"></p>
    </div>
  </form>

  <p class="comment-admin">
    <button type="button" class="comment-admin-toggle" data-admin-toggle>管理</button>
  </p>
</section>

<script>
  const root = document.querySelector('[data-comments]');

  if (root) {
    const slug = root.dataset.slug;
    const API = '/api/comments';
    const ADMIN_KEY = 'comments-admin-token';
    // 页面渲染时间，用来判断提交是不是「快得不像人」
    const renderedAt = Date.now();

    const listEl = root.querySelector('[data-list]');
    const statusEl = root.querySelector('[data-status]');
    const countEl = root.querySelector('[data-count]');
    const form = root.querySelector('[data-form]');
    const formStatus = root.querySelector('[data-form-status]');
    const submitBtn = root.querySelector('[data-submit]');
    const adminToggle = root.querySelector('[data-admin-toggle]');

    let adminToken = '';
    try {
      adminToken = localStorage.getItem(ADMIN_KEY) || '';
    } catch (err) {
      /* 隐私模式下 localStorage 可能不可用，忽略即可 */
    }

    const pad = (n) => String(n).padStart(2, '0');
    function formatTime(iso) {
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return '';
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }

    function setStatus(el, text, kind) {
      el.textContent = text || '';
      if (kind) el.dataset.kind = kind;
      else delete el.dataset.kind;
    }

    function syncAdminToggle() {
      adminToggle.textContent = adminToken ? '退出管理' : '管理';
    }

    // 一律用 textContent 写入，绝不拼 innerHTML —— 留言是用户输入
    function buildComment(comment) {
      const item = document.createElement('article');
      item.className = 'comment';
      item.id = `comment-${comment.id}`;
      item.tabIndex = -1;

      const head = document.createElement('div');
      head.className = 'comment-head';

      const name = document.createElement('span');
      name.className = 'comment-name';
      name.textContent = comment.name;

      const time = document.createElement('time');
      time.className = 'comment-time';
      time.dateTime = comment.createdAt;
      time.textContent = formatTime(comment.createdAt);

      head.append(name, time);

      if (adminToken) {
        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'comment-delete';
        del.textContent = '删除';
        del.addEventListener('click', () => removeComment(comment.id));
        head.append(del);
      }

      const body = document.createElement('div');
      body.className = 'comment-body';
      body.textContent = comment.body;

      item.append(head, body);
      return item;
    }

    function renderComments(comments) {
      listEl.textContent = '';

      if (!comments.length) {
        const empty = document.createElement('p');
        empty.className = 'comments-status';
        empty.textContent = '还没有人留言。';
        listEl.append(empty);
        return;
      }

      for (const comment of comments) {
        listEl.append(buildComment(comment));
      }
    }

    // 从留言墙点进来时，滚动到对应的那条留言，并用冰蓝描边闪一下
    let hashHandled = false;
    function revealFromHash() {
      if (hashHandled) return;
      hashHandled = true;
      const raw = window.location.hash;
      if (!raw.startsWith('#comment-')) return;

      let target = null;
      try {
        target = document.getElementById(decodeURIComponent(raw.slice(1)));
      } catch {
        target = null;
      }

      if (!target) {
        // 留言可能已经被删了：退回到留言区顶部，至少不让读者停在页面最上面
        root.scrollIntoView({ block: 'start' });
        return;
      }

      target.classList.add('is-target');
      requestAnimationFrame(() => {
        target.scrollIntoView({ block: 'start' });
        target.focus({ preventScroll: true });
      });
    }

    async function load() {
      setStatus(statusEl, '正在加载留言…');
      try {
        const res = await fetch(`${API}?slug=${encodeURIComponent(slug)}`, {
          headers: { Accept: 'application/json' },
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || '加载失败');

        const comments = data.comments || [];
        countEl.textContent = comments.length ? `（${comments.length}）` : '';
        renderComments(comments);
        revealFromHash();
      } catch (err) {
        // 本地没有 Functions API / 网络暂时不通时，给一句人话，而不是把异常直接抛给读者
        setStatus(statusEl, `留言暂时没有接通（${err.message}）。可以稍后刷新再试试。`, 'error');
      }
    }

    async function removeComment(id) {
      if (!window.confirm('确定删掉这条留言吗？')) return;
      try {
        const res = await fetch(
          `${API}?slug=${encodeURIComponent(slug)}&id=${encodeURIComponent(id)}`,
          { method: 'DELETE', headers: { 'x-admin-token': adminToken } }
        );
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || '删除失败');
        await load();
      } catch (err) {
        window.alert(`删除失败：${err.message}`);
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const body = String(data.get('body') || '').trim();
      if (!body) {
        setStatus(formStatus, '内容不能为空', 'error');
        return;
      }

      submitBtn.disabled = true;
      setStatus(formStatus, '正在发表…');

      try {
        const res = await fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            slug,
            name: String(data.get('name') || ''),
            body,
            website: String(data.get('website') || ''),
            elapsed: Date.now() - renderedAt,
          }),
        });
        const result = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(result.error || '发表失败');

        form.reset();
        setStatus(formStatus, '发表成功', 'ok');
        await load();
      } catch (err) {
        setStatus(formStatus, err.message, 'error');
      } finally {
        submitBtn.disabled = false;
      }
    });

    adminToggle.addEventListener('click', () => {
      if (adminToken) {
        if (!window.confirm('退出管理模式？删除按钮会隐藏。')) return;
        adminToken = '';
        try {
          localStorage.removeItem(ADMIN_KEY);
        } catch (err) {}
        syncAdminToggle();
        load();
        return;
      }

      const input = window.prompt(
        '粘贴管理令牌。\n\n获取位置：Azure 门户 → zinchl-blog → 配置 → COMMENTS_ADMIN_TOKEN'
      );
      if (!input || !input.trim()) return;

      adminToken = input.trim();
      try {
        localStorage.setItem(ADMIN_KEY, adminToken);
      } catch (err) {}
      syncAdminToggle();
      load();
    });

    syncAdminToggle();
    load();
  }
</script>
