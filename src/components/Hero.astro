---
import Starfield from './Starfield.astro';
import Icon from './Icon.astro';
import { SITE } from '../site.config';

/**
 * 首屏 —— 「SIGNAL / 001」
 * 纯黑画布、巨大字标、十字轨道线与两个信号色（金 / 冰蓝）。
 */
const socialIcon = (icon: string) =>
  icon === 'github' ? 'github' : icon === 'email' ? 'email' : icon === 'rss' ? 'rss' : 'link';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <Starfield class="hero-starfield" density={1} parallax={true} />
    <div class="hero-gridlines"></div>
    <div class="hero-glow hero-glow--ice"></div>
    <div class="hero-glow hero-glow--gold"></div>
  </div>

  <div class="hero-marks" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </div>
  <p class="hero-side hero-side--left mono" aria-hidden="true">21NC — PERSONAL ARCHIVE</p>
  <p class="hero-side hero-side--right mono" aria-hidden="true">{SITE.locationEn} — {SITE.coords}</p>

  <div class="hero-inner wrap">
    <div class="hero-top">
      <p class="hero-eyebrow eyebrow">PERSONAL ARCHIVE <span aria-hidden="true">—</span> SIGNAL 001</p>
      <p class="hero-meta mono">
        <span class="clock" data-clock data-tz={SITE.timeZone}>--:--:--</span>
        {SITE.clockLabel} <span aria-hidden="true">/</span> {SITE.locationEn}
      </p>
    </div>

    <div class="hero-center">
      <h1 class="hero-title" id="hero-title">
        <span class="hero-title__solid">21</span><span class="hero-title__accent">nc</span>
      </h1>

      <svg class="hero-orbit" viewBox="0 0 1400 480" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="1">
          <ellipse class="orbit-line orbit-line--a" cx="700" cy="240" rx="646" ry="152" transform="rotate(-7 700 240)" stroke-opacity=".2"></ellipse>
          <ellipse class="orbit-line orbit-line--b" cx="700" cy="240" rx="472" ry="94" transform="rotate(9 700 240)" stroke-opacity=".12" stroke-dasharray="2 9"></ellipse>
          <path class="orbit-line orbit-line--axis" d="M16 240H1384" stroke-opacity=".14"></path>
          <path d="M700 22V458" stroke-opacity=".06"></path>
        </g>
        <g fill="none" stroke="currentColor" stroke-opacity=".3">
          <path d="M52 232v16M700 22h16M1348 232v16"></path>
        </g>
        <circle class="orbit-dot orbit-dot--ice" cx="1268" cy="160" r="3.4"></circle>
        <circle class="orbit-dot orbit-dot--gold" cx="142" cy="298" r="2.6"></circle>
        <text class="orbit-label" x="1222" y="134" fill="currentColor" fill-opacity=".5">SIG / 001</text>
        <text class="orbit-label" x="72" y="330" fill="currentColor" fill-opacity=".32">RA 21H · DEC +36°</text>
      </svg>

      <div class="hero-tagline">
        <p class="hero-tagline__cmd mono">
          <span class="hero-tagline__prompt" aria-hidden="true">&gt;</span>world.execute(me)<span
            class="hero-tagline__caret"
            aria-hidden="true"></span>
        </p>
        <p class="hero-tagline__en mono">
          CODE <span aria-hidden="true">/</span> STARS <span aria-hidden="true">/</span> NOTES
        </p>
      </div>
    </div>

    <div class="hero-bottom">
      <p class="hero-desc">{SITE.hero.description}</p>
      <div class="hero-actions">
        <a class="btn" href="#recent" data-magnetic>
          {SITE.hero.primaryCta}
          <span class="btn-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="link-underline" href="/about/">
          关于这间<span aria-hidden="true">→</span>
        </a>
      </div>
      <ul class="hero-socials" aria-label="社交链接">
        {
          SITE.social.map((item) => (
            <li>
              <a href={item.href} rel="me noopener" target={item.href.startsWith('http') ? '_blank' : undefined}>
                <Icon name={socialIcon(item.icon)} size={12} />
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/rss.xml">
            <Icon name="rss" size={12} />
            RSS
          </a>
        </li>
      </ul>
    </div>

    <div class="hero-foot">
      <a class="hero-scroll mono" href="#recent">
        SCROLL
        <span class="hero-scroll__line" aria-hidden="true"></span>
        <span aria-hidden="true">↓</span>
      </a>
      <p class="hero-foot__center mono">KNOWLEDGE · CURIOSITY · INFINITY</p>
      <p class="hero-foot__index mono">VOL. I <span aria-hidden="true">/</span> EST. {SITE.since}</p>
    </div>
  </div>

  <script>
    // 轨道与字标随鼠标轻微视差 —— 仅精细指针、非降级动效
    (() => {
      const hero = document.querySelector<HTMLElement>('.hero');
      const orbit = document.querySelector<HTMLElement>('.hero-orbit');
      if (!hero || !orbit) return;
      if (!window.matchMedia('(pointer: fine)').matches) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let raf = 0;
      let tx = 0;
      let ty = 0;
      const apply = () => {
        raf = 0;
        orbit.style.setProperty('--orbit-x', `${tx.toFixed(2)}px`);
        orbit.style.setProperty('--orbit-y', `${ty.toFixed(2)}px`);
      };
      hero.addEventListener('pointermove', (event) => {
        const rect = hero.getBoundingClientRect();
        tx = ((event.clientX - rect.left) / rect.width - 0.5) * -16;
        ty = ((event.clientY - rect.top) / rect.height - 0.5) * -12;
        if (!raf) raf = requestAnimationFrame(apply);
      });
      hero.addEventListener('pointerleave', () => {
        tx = 0;
        ty = 0;
        if (!raf) raf = requestAnimationFrame(apply);
      });
    })();
  </script>
</section>
