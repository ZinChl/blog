---
/**
 * 星盘 —— 首页右侧的观测仪插图。
 * 纯 SVG 线稿 + CSS 动画，无位图，日间/夜间主题自动跟随。
 */
const CX = 320;
const CY = 336;

const ticks = Array.from({ length: 72 }, (_, i) => {
  const angle = (i * 5 * Math.PI) / 180;
  const long = i % 6 === 0;
  const r1 = 246;
  const r2 = long ? 258 : 252;
  return {
    x1: +(CX + r1 * Math.sin(angle)).toFixed(2),
    y1: +(CY - r1 * Math.cos(angle)).toFixed(2),
    x2: +(CX + r2 * Math.sin(angle)).toFixed(2),
    y2: +(CY - r2 * Math.cos(angle)).toFixed(2),
    long,
  };
});

const stars = [
  { x: 452, y: 138, r: 1.5 },
  { x: 486, y: 176, r: 0.9 },
  { x: 420, y: 196, r: 0.7 },
  { x: 505, y: 236, r: 1.1 },
  { x: 462, y: 252, r: 0.7 },
  { x: 530, y: 150, r: 0.8 },
  { x: 148, y: 470, r: 1.2 },
  { x: 186, y: 512, r: 0.7 },
  { x: 122, y: 540, r: 0.9 },
  { x: 214, y: 566, r: 0.6 },
];
---

<svg
  class="astrolabe"
  viewBox="0 0 640 680"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false">
  <defs>
    <linearGradient id="ag-gold" x1="120" y1="80" x2="520" y2="620" gradientUnits="userSpaceOnUse">
      <stop stop-color="#8a6a2f" stop-opacity=".35"></stop>
      <stop offset=".45" stop-color="#e7cb93" stop-opacity=".9"></stop>
      <stop offset=".72" stop-color="#d6b36a" stop-opacity=".7"></stop>
      <stop offset="1" stop-color="#a9823f" stop-opacity=".35"></stop>
    </linearGradient>
    <radialGradient id="ag-halo" cx="0" cy="0" r="1" gradientTransform="translate(320 336) rotate(90) scale(300)" gradientUnits="userSpaceOnUse">
      <stop stop-color="#b4abf0" stop-opacity=".2"></stop>
      <stop offset=".5" stop-color="#b4abf0" stop-opacity=".06"></stop>
      <stop offset="1" stop-color="#b4abf0" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="ag-core" cx="0" cy="0" r="1" gradientTransform="translate(320 336) rotate(90) scale(78)" gradientUnits="userSpaceOnUse">
      <stop stop-color="#f8e7c0" stop-opacity=".55"></stop>
      <stop offset=".55" stop-color="#d6b36a" stop-opacity=".16"></stop>
      <stop offset="1" stop-color="#d6b36a" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="ag-star" x1="320" y1="238" x2="320" y2="434" gradientUnits="userSpaceOnUse">
      <stop stop-color="#f4dfb0"></stop>
      <stop offset=".5" stop-color="#d6b36a"></stop>
      <stop offset="1" stop-color="#b4abf0"></stop>
    </linearGradient>
    <linearGradient id="ag-comet" x1="0" y1="0" x2="-46" y2="28" gradientUnits="userSpaceOnUse">
      <stop stop-color="#f4dfb0" stop-opacity=".8"></stop>
      <stop offset="1" stop-color="#f4dfb0" stop-opacity="0"></stop>
    </linearGradient>
    <filter id="ag-blur" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="20"></feGaussianBlur>
    </filter>
    <filter id="ag-blur-sm" x="-80%" y="-80%" width="260%" height="260%">
      <feGaussianBlur stdDeviation="5"></feGaussianBlur>
    </filter>
  </defs>

  <!-- 光晕 -->
  <circle class="astro-halo-disc" cx={CX} cy={CY} r="300" fill="url(#ag-halo)"></circle>
  <circle class="astro-core-glow" cx={CX} cy={CY} r="118" fill="url(#ag-core)" filter="url(#ag-blur)"></circle>

  <!-- 固定外环 + 刻度 -->
  <circle cx={CX} cy={CY} r="246" stroke="url(#ag-gold)" stroke-opacity=".55" stroke-width="1"></circle>
  <circle cx={CX} cy={CY} r="232" stroke="#d6b36a" stroke-opacity=".16" stroke-width=".8" stroke-dasharray="1 6"></circle>
  <g stroke="#d6b36a" stroke-opacity=".45" stroke-width=".8" stroke-linecap="round">
    {ticks.map((t) => (
      <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke-opacity={t.long ? 0.6 : 0.28}></line>
    ))}
  </g>

  <!-- 旋转外环（分段虚线 + 四个节点） -->
  <g class="astro-spin-slow" stroke="#d6b36a" stroke-opacity=".5">
    <circle cx={CX} cy={CY} r="264" stroke-width=".9" stroke-dasharray="96 34 22 34"></circle>
    <path d="M320 60l5 10-5 10-5-10 5-10Z" fill="#d6b36a" fill-opacity=".7" stroke="none"></path>
    <path d="M320 592l4 8-4 8-4-8 4-8Z" fill="#d6b36a" fill-opacity=".4" stroke="none"></path>
    <path d="M44 336l8-4 8 4-8 4-8-4Z" fill="#b4abf0" fill-opacity=".6" stroke="none"></path>
    <path d="M580 336l8-4 8 4-8 4-8-4Z" fill="#b4abf0" fill-opacity=".5" stroke="none"></path>
  </g>

  <!-- 交叉准线 -->
  <g stroke="#d6b36a" stroke-opacity=".14" stroke-width=".7">
    <path d={`M${CX} 74V598M58 ${CY}H582`}></path>
    <circle cx={CX} cy={CY} r="150" stroke-dasharray="2 7" stroke-opacity=".22"></circle>
    <circle cx={CX} cy={CY} r="120" stroke-opacity=".18"></circle>
  </g>

  <!-- 倾斜轨道 + 行星 -->
  <g class="astro-spin-rev" style="transform-origin: 320px 336px;">
    <ellipse
      cx={CX}
      cy={CY}
      rx="296"
      ry="104"
      transform={`rotate(-22 ${CX} ${CY})`}
      stroke="#e7cb93"
      stroke-opacity=".5"
      stroke-width="1"></ellipse>
    <circle cx={CX + 296} cy={CY} r="4" fill="#e7cb93" fill-opacity=".9"></circle>
    <circle cx={CX + 296} cy={CY} r="8" fill="#e7cb93" fill-opacity=".14"></circle>
  </g>
  <g class="astro-spin-mid" style="transform-origin: 320px 336px;">
    <ellipse
      cx={CX}
      cy={CY}
      rx="214"
      ry="74"
      transform={`rotate(28 ${CX} ${CY})`}
      stroke="#b4abf0"
      stroke-opacity=".4"
      stroke-width=".9"
      stroke-dasharray="3 5"></ellipse>
    <circle cx={CX - 214} cy={CY} r="3" fill="#b4abf0" fill-opacity=".85"></circle>
    <circle cx={CX - 214} cy={CY} r="7" fill="#b4abf0" fill-opacity=".12"></circle>
  </g>

  <!-- 中心星 -->
  <g class="astro-pulse">
    <circle cx={CX} cy={CY} r="86" fill="url(#ag-core)" filter="url(#ag-blur)" opacity=".9"></circle>
    <path
      class="astro-star-main"
      d="M320 240l11 74 74 22-74 22-11 74-11-74-74-22 74-22 11-74Z"
      fill="url(#ag-star)"
      fill-opacity=".92"
      filter="url(#ag-blur-sm)"></path>
    <path
      d="M320 262l8 56 56 18-56 18-8 56-8-56-56-18 56-18 8-56Z"
      fill="url(#ag-star)"
      fill-opacity=".98"></path>
    <path
      d="M320 296l4 32 32 8-32 8-4 32-4-32-32-8 32-8 4-32Z"
      fill="#f4e0b6"
      opacity=".95"></path>
    <circle cx={CX} cy={CY} r="22" fill="none" stroke="#e7cb93" stroke-opacity=".4" stroke-width=".7"></circle>
    <circle cx={CX} cy={CY} r="3" fill="#fff7e4"></circle>
  </g>

  <!-- 星座线稿 -->
  <g class="twinkle">
    <g stroke="#d6b36a" stroke-opacity=".25" stroke-width=".6">
      <path d="M452 138l34 38-32 20 43 40-35 16"></path>
      <path d="M420 196l32 20 43-58"></path>
    </g>
    {stars.map((s, i) => (
      <circle cx={s.x} cy={s.y} r={s.r} fill="#e7cb93" fill-opacity={i % 2 ? 0.5 : 0.75}></circle>
    ))}
    <text x="470" y="118" fill="#d6b36a" fill-opacity=".45" font-size="7" letter-spacing="2">CYGNUS</text>
    <text x="470" y="268" fill="#b4abf0" fill-opacity=".4" font-size="7" letter-spacing="2">LYRA</text>
  </g>

  <!-- 第二组小星 -->
  <g class="twinkle">
    <g stroke="#b4abf0" stroke-opacity=".22" stroke-width=".6">
      <path d="M148 470l38 42-64 28 26 48"></path>
    </g>
    {stars.slice(6).map((s) => (
      <circle cx={s.x} cy={s.y} r={s.r} fill="#b4abf0" fill-opacity=".55"></circle>
    ))}
    <text x="96" y="452" fill="#b4abf0" fill-opacity=".35" font-size="6.5" letter-spacing="2">ORION</text>
  </g>

  <!-- 彗星 -->
  <g class="comet">
    <line x1="0" y1="0" x2="-52" y2="30" stroke="url(#ag-comet)" stroke-width="1.4"></line>
    <circle cx="0" cy="0" r="2" fill="#fff3d6"></circle>
    <circle cx="0" cy="0" r="5" fill="#fff3d6" fill-opacity=".18"></circle>
  </g>

  <!-- 四角标注 -->
  <g fill="#d6b36a" fill-opacity=".4" font-size="7.5" letter-spacing="2.2">
    <text x="36" y="60">RA 21H 04M</text>
    <text x="36" y="74" fill-opacity=".25">DEC +36° 12′</text>
    <text x="472" y="628" text-anchor="end" fill-opacity=".3">FIG. 01 — ASTROLARIUM</text>
    <text x="320" y="656" text-anchor="middle" fill-opacity=".22">AD ASTRA PER SCIENTIAM</text>
  </g>
  <g stroke="#d6b36a" stroke-opacity=".35" stroke-width="1">
    <path d="M36 96v-12h12M604 84v12h-12M36 576v12h12M604 588v-12h-12"></path>
  </g>
</svg>
